import java.util.ArrayList;
import java.util.Scanner;

class Book {
    private int id;
    private String title;
    private String author;
    private boolean isIssued;
    
    public Book(int id, String title, String author) {
        this.id = id;
        this.title = title;
        this.author = author;
        this.isIssued = false;
    }
    
    public int getId() { return id; }
    public String getTitle() { return title; }
    public String getAuthor() { return author; }
    public boolean isIssued() { return isIssued; }
    public void setIssued(boolean issued) { isIssued = issued; }
    
    public void displayBook() {
        System.out.println("ID: " + id + " | Title: " + title + " | Author: " + author + 
                         " | Status: " + (isIssued ? "Issued" : "Available"));
    }
}

class Library {
    private ArrayList<Book> books;
    private int nextId;
    
    public Library() {
        books = new ArrayList<>();
        nextId = 1;
        addSampleBooks();
    }
    
    private void addSampleBooks() {
        books.add(new Book(nextId++, "The Great Gatsby", "F. Scott Fitzgerald"));
        books.add(new Book(nextId++, "To Kill a Mockingbird", "Harper Lee"));
        books.add(new Book(nextId++, "1984", "George Orwell"));
        books.add(new Book(nextId++, "Pride and Prejudice", "Jane Austen"));
    }
    
    public void addBook(String title, String author) {
        Book book = new Book(nextId++, title, author);
        books.add(book);
        System.out.println("✓ Book added successfully! Book ID: " + book.getId());
    }
    
    public void displayAllBooks() {
        if (books.isEmpty()) {
            System.out.println("No books in the library.");
            return;
        }
        System.out.println("\n=== All Books ===");
        for (Book book : books) {
            book.displayBook();
        }
    }
    
    public void displayAvailableBooks() {
        boolean found = false;
        System.out.println("\n=== Available Books ===");
        for (Book book : books) {
            if (!book.isIssued()) {
                book.displayBook();
                found = true;
            }
        }
        if (!found) {
            System.out.println("No books available at the moment.");
        }
    }
    
    public void searchBook(String keyword) {
        boolean found = false;
        System.out.println("\n=== Search Results ===");
        for (Book book : books) {
            if (book.getTitle().toLowerCase().contains(keyword.toLowerCase()) ||
                book.getAuthor().toLowerCase().contains(keyword.toLowerCase())) {
                book.displayBook();
                found = true;
            }
        }
        if (!found) {
            System.out.println("No books found matching '" + keyword + "'");
        }
    }
    
    public boolean issueBook(int id) {
        for (Book book : books) {
            if (book.getId() == id) {
                if (book.isIssued()) {
                    System.out.println("Book is already issued!");
                    return false;
                }
                book.setIssued(true);
                System.out.println("✓ Book issued successfully: " + book.getTitle());
                return true;
            }
        }
        System.out.println("Book not found with ID: " + id);
        return false;
    }
    
    public boolean returnBook(int id) {
        for (Book book : books) {
            if (book.getId() == id) {
                if (!book.isIssued()) {
                    System.out.println("This book wasn't issued!");
                    return false;
                }
                book.setIssued(false);
                System.out.println("✓ Book returned successfully: " + book.getTitle());
                return true;
            }
        }
        System.out.println("Book not found with ID: " + id);
        return false;
    }
    
    public boolean deleteBook(int id) {
        for (int i = 0; i < books.size(); i++) {
            if (books.get(i).getId() == id) {
                if (books.get(i).isIssued()) {
                    System.out.println("Cannot delete an issued book! Return it first.");
                    return false;
                }
                books.remove(i);
                System.out.println("✓ Book deleted successfully!");
                return true;
            }
        }
        System.out.println("Book not found with ID: " + id);
        return false;
    }
}

public class library {
    private static Scanner scanner = new Scanner(System.in);
    private static Library library = new Library();
    
    public static void main(String[] args) {
        System.out.println("=================================");
        System.out.println("📚 LIBRARY MANAGEMENT SYSTEM 📚");
        System.out.println("=================================");
        
        while (true) {
            displayMenu();
            int choice = getIntInput("Enter your choice: ");
            
            switch (choice) {
                case 1:
                    addNewBook();
                    break;
                case 2:
                    library.displayAllBooks();
                    break;
                case 3:
                    library.displayAvailableBooks();
                    break;
                case 4:
                    searchBooks();
                    break;
                case 5:
                    issueBook();
                    break;
                case 6:
                    returnBook();
                    break;
                case 7:
                    deleteBook();
                    break;
                case 8:
                    System.out.println("\nThank you for using Library Management System!");
                    System.out.println("Goodbye! 👋");
                    scanner.close();
                    System.exit(0);
                    break;
                default:
                    System.out.println("Invalid choice! Please try again.");
            }
            
            System.out.println("\nPress Enter to continue...");
            scanner.nextLine();
            scanner.nextLine();
        }
    }
    
    private static void displayMenu() {
        System.out.println("\n=== MENU ===");
        System.out.println("1. Add New Book");
        System.out.println("2. Display All Books");
        System.out.println("3. Display Available Books");
        System.out.println("4. Search Books");
        System.out.println("5. Issue Book");
        System.out.println("6. Return Book");
        System.out.println("7. Delete Book");
        System.out.println("8. Exit");
    }
    
    private static void addNewBook() {
        System.out.println("\n--- Add New Book ---");
        System.out.print("Enter book title: ");
        String title = scanner.nextLine();
        System.out.print("Enter book author: ");
        String author = scanner.nextLine();
        library.addBook(title, author);
    }
    
    private static void searchBooks() {
        System.out.println("\n--- Search Books ---");
        System.out.print("Enter title or author to search: ");
        String keyword = scanner.nextLine();
        library.searchBook(keyword);
    }
    
    private static void issueBook() {
        System.out.println("\n--- Issue Book ---");
        library.displayAvailableBooks();
        int id = getIntInput("Enter book ID to issue: ");
        library.issueBook(id);
    }
    
    private static void returnBook() {
        System.out.println("\n--- Return Book ---");
        int id = getIntInput("Enter book ID to return: ");
        library.returnBook(id);
    }
    
    private static void deleteBook() {
        System.out.println("\n--- Delete Book ---");
        library.displayAllBooks();
        int id = getIntInput("Enter book ID to delete: ");
        library.deleteBook(id);
    }
    
    private static int getIntInput(String message) {
        System.out.print(message);
        while (!scanner.hasNextInt()) {
            System.out.print("Invalid input! Please enter a number: ");
            scanner.next();
        }
        int input = scanner.nextInt();
        scanner.nextLine();
        return input;
    }
}
